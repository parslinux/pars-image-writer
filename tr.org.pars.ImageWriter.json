{
  "app-id": "tr.org.pars.ImageWriter",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "pars-image-writer",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=all",
    "--filesystem=host",
    "--filesystem=/run/udev:ro",
    "--talk-name=org.freedesktop.PolicyKit1",
    "--talk-name=org.freedesktop.Notifications",
    "--system-talk-name=org.freedesktop.UDisks2"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "pars-image-writer",
      "buildsystem": "simple",
      "build-commands": [
        "python3 setup.py install --prefix=/app --root=/",
        "install -Dm644 tr.org.pars.ImageWriter.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 assets/pars-image-writer.svg /app/share/icons/hicolor/scalable/apps/tr.org.pars.ImageWriter.svg",
        "install -Dm644 tr.org.pars.image-writer.desktop /app/share/applications/tr.org.pars.ImageWriter.desktop",
        "sed -i 's/Icon=pars-image-writer/Icon=tr.org.pars.ImageWriter/g' /app/share/applications/tr.org.pars.ImageWriter.desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
